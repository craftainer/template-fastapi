{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(prek *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(docker *)",
      "Bash(locust *)",
      "Bash(py-spy *)",
      "Bash(python3 *)",
      "Bash(make *)",
      "WebSearch",
      "WebFetch",
      "mcp__plugin_context7_context7__*"
    ],
    "ask": [
      "Bash(gh workflow run release.yml *)",
      "Bash(gh variable set *)"
    ],
    "deny": [
      "mcp__s3-mcp__put_object",
      "mcp__s3-mcp__delete_object",
      "mcp__s3-mcp__copy_object",
      "mcp__s3-mcp__create_bucket",
      "mcp__s3-mcp__delete_bucket",
      "mcp__s3-mcp__presign_put",
      "Bash(uv publish *)",
      "Bash(twine *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/self-check.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "snip hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  }
}
