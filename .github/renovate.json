{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "patch and minor updates",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "major updates"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^(app\\.)?Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\nARG \\w+_VERSION=(?<currentValue>.*)\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
<<<<<<< /home/runner/work/template-fastapi/template-fastapi/.github/renovate.json
        "/^scripts/develop\\.d/.*\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n\\w+_VERSION=(?<currentValue>.*)\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n\\w+_VERSION := (?<currentValue>.*)\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.claude/mcp/playwright_selenium_bridge\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*\\n_PLAYWRIGHT_MCP_VERSION = \"(?<currentValue>.*)\"\\s"
